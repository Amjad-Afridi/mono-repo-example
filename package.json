{
  "name": "crud-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "build": "npm run build --workspace apps/web",
    "start": "node apps/api/server.js",
    "test": "node --test packages/shared/index.test.js",
    "preview": "npm run preview --workspace apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
